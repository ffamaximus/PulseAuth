<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unique per package — shared properties (Version, Authors, TargetFrameworks, etc.)
         come from Directory.Build.props in the repo root. -->
    <PackageId>PulseAuth</PackageId>
    <RootNamespace>PulseAuth</RootNamespace>
    <AssemblyName>PulseAuth</AssemblyName>
    <Description>Free, open-source OAuth2/OpenID Connect authorization server for ASP.NET Core. Supports Authorization Code + PKCE, Client Credentials, Refresh Token, social token exchange (Google, Facebook) and external provider flows.</Description>
    <PackageTags>oauth2;oidc;openidconnect;jwt;authorization;authentication;aspnetcore;identity</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Microsoft.IdentityModel ships independently of the .NET runtime — any 8.x or newer is fine. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="[8.0.0,)" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens"                  Version="[8.0.0,)" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"                 Version="[8.0.0,)" />
  </ItemGroup>

  <!-- ASP.NET Core auth providers are versioned together with the runtime.
       Each TFM group pins to that major version only, preventing a mismatch
       (e.g. net8.0 pulling in a v9 package). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook"        Version="[10.0.0,11.0.0)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google"          Version="[10.0.0,11.0.0)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="[10.0.0,11.0.0)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook"        Version="[9.0.0,10.0.0)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google"          Version="[9.0.0,10.0.0)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="[9.0.0,10.0.0)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook"        Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google"          Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="[8.0.0,9.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
