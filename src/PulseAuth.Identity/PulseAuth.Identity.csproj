<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unique per package — shared properties come from Directory.Build.props -->
    <PackageId>PulseAuth.Identity</PackageId>
    <RootNamespace>PulseAuth.Identity</RootNamespace>
    <AssemblyName>PulseAuth.Identity</AssemblyName>
    <Description>ASP.NET Core Identity integration for PulseAuth — connects PulseAuth's user authentication to Identity's UserManager and SignInManager.</Description>
    <PackageTags>oauth2;identity;aspnetcore;authentication</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference converts to PackageReference automatically when running dotnet pack -->
    <ProjectReference Include="..\PulseAuth\PulseAuth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png"  Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
