<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unique per package — shared properties come from Directory.Build.props -->
    <PackageId>PulseAuth.EntityFramework</PackageId>
    <RootNamespace>PulseAuth.EntityFramework</RootNamespace>
    <AssemblyName>PulseAuth.EntityFramework</AssemblyName>
    <Description>Entity Framework Core persistent stores for PulseAuth — clients, authorization codes, refresh tokens and grants backed by any EF Core provider.</Description>
    <PackageTags>oauth2;entityframework;efcore;aspnetcore;authentication</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="[8.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.2,)" />
  </ItemGroup>

  <!--
    EF Core is compiled against the major that matches each target framework.
    EF Core 10 moved ExecuteUpdate/ExecuteDelete (binary breaking change): a net10.0 build compiled
    against EF Core 8 fails at runtime with MissingMethodException
    ('RelationalQueryableExtensions.ExecuteDeleteAsync') when the app uses EF Core 10.
    net8.0 / net9.0 builds keep working with EF Core 8 and 9 (EF Core 10 requires net10.0).
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[8.0.2,)" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="[8.0.2,)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.0,)" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="[10.0.0,)" />
  </ItemGroup>

  <!-- Design-time only: required by the dotnet-ef CLI tool to recognize the DbContext when
       scanning this library. PrivateAssets="all" ensures it is NOT published as a dependency.
       No provider is embedded — run migrations from your startup project:
         dotnet ef migrations add Init
           \-\-project src/PulseAuth.EntityFramework
           \-\-startup-project src/YourApp
           \-\-context PulseAuthDbContext -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[8.0.2,)" PrivateAssets="all"
                      Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.0,)" PrivateAssets="all"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference converts to PackageReference automatically when running dotnet pack -->
    <ProjectReference Include="..\PulseAuth\PulseAuth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
