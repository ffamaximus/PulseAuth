<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Reference authorization server used to run the OpenID Foundation conformance suite
    (Basic OP plan) against PulseAuth. NOT a production template: fixed test user, auto-login.
  -->
  <PropertyGroup>
    <!-- Override the multi-target / packaging settings from Directory.Build.props -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PulseAuth\PulseAuth.csproj" />
  </ItemGroup>

</Project>
